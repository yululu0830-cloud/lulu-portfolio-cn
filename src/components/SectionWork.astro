---
import { work as img, workThumbnails, workBilibiliLinks } from "../data/assets.ts";

/** 连续汉字块与拉丁/数字分开，中文强制数黑体、英文强制 Fraunces（不依赖 font 回退顺序） */
function workTitleSegments(title: string): { latin: boolean; text: string }[] {
  const out: { latin: boolean; text: string }[] = [];
  const re = /[\u4E00-\u9FFF\u3400-\u4DBF]+/gu;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(title)) !== null) {
    if (m.index > last) out.push({ latin: true, text: title.slice(last, m.index) });
    out.push({ latin: false, text: m[0] });
    last = m.index + m[0].length;
  }
  if (last < title.length) out.push({ latin: true, text: title.slice(last) });
  if (out.length === 0) out.push({ latin: true, text: title });
  return out;
}

